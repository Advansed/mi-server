{
  "name": "mi-server",
  "version": "1.0.1",
  "description": "Node server with Prisma for mi-data",
  "scripts": {
    "build": "tsc",
    "prestart": "node scripts/drop-esm-proxy-agents.js",
    "start": "node --env-file=.env dist/index.js",
    "prework": "node scripts/drop-esm-proxy-agents.js",
    "work": "pm2 startOrRestart ecosystem.config.cjs",
    "predev": "node scripts/drop-esm-proxy-agents.js",
    "dev": "node --watch --env-file=.env dist/index.js",
    "dev:tsc": "tsc --watch",
    "postinstall": "node scripts/drop-esm-proxy-agents.js && prisma generate",
    "db:generate": "prisma generate",
    "test": "node --test dist/guid.test.js"
  },
  "dependencies": {
    "@prisma/adapter-mssql": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "mssql": "^11.0.2",
    "puppeteer": "^24.33.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@typespec/ts-http-runtime": {
      "https-proxy-agent": "7.0.6",
      "http-proxy-agent": "7.0.2"
    }
  }
}
