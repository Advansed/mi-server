{
  "name": "mi-server",
  "version": "1.0.1",
  "description": "Node server with Prisma for mi-data",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --watch --env-file=.env dist/index.js",
    "dev:tsc": "tsc --watch",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "test": "node --test dist/guid.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "puppeteer": "^24.33.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3"
  }
}
